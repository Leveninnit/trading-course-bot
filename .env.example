# Copy this file to ".env" for local testing. Never commit your real .env file.
DISCORD_TOKEN=your-bot-token-here

# Optional — only needed if you want to override guild_id from config.json this way instead.
# GUILD_ID=123456789012345678

# Optional — only needed if you want to override owner_id from config.json this way instead.
# OWNER_ID=123456789012345678

# Optional — enables AI-powered commands (/explain, /ask, /motivate, /lesson, and upgrades /quote
# to generate fresh lines instead of picking from a static list). Without this, those commands
# just say AI isn't configured yet, and /quote keeps using its static list -- nothing breaks.
# Get a free key (no credit card required) at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional — override the Gemini model used for AI commands (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
